# ============================================
# TVCastAPI Docs Frontend - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# All variables are OPTIONAL - the docs site works without them
# ============================================

# ============================================
# BACKEND API CONFIGURATION (Optional)
# ============================================
# Backend API URL used for API testing helpers in the documentation site
# If not set, users can manually enter the API URL in the testing page
NEXT_PUBLIC_API_URL=https://your-api-domain.com

# ============================================
# SITE CONFIGURATION (Optional)
# ============================================
# Public URL of your documentation site
# Used for metadata and OG images
# Defaults to http://localhost:3001 in development
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ============================================
# TELEGRAM SUPPORT (Required for Support Form)
# ============================================
# Telegram bot token from @BotFather
# Required for the maintainer support form to forward messages to Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram chat or channel ID where support form messages should be delivered
# Required for the maintainer support form
TELEGRAM_CHAT_ID=123456789

# ============================================
# TIMEZONE (Optional)
# ============================================
# Timezone for timestamps in Telegram support messages
# Defaults to Asia/Dhaka if not specified
TIMEZONE=Asia/Dhaka